rules_version = '2';

// Security rules for Storyboard Maker: team storyboards and client review links.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Who can do what (team storyboards):
// - People sign in with Google. Only team members (members/{email}) can see or open the team's
//   storyboards. The first person to set up the team becomes its admin. Admins approve people
//   by email. If the team has a domain set (team/settings.domain), anyone signed in with a
//   Google account at that domain can add themselves as a member.
// - Removing someone whose email is at the team's domain marks them "removed" rather than
//   deleting them, so they can't add themselves back.
// - One editor at a time: only the member holding a storyboard's lock can save it. Any member can
//   take the lock (the app asks first) or release it.
//
// Who can do what (client review links):
// - Only team members can create client links.
// - Anyone with a review link can view the storyboard and all comments (no account needed;
//   browsers sign in anonymously behind the scenes so people can edit their own comments).
// - Nobody can list or browse reviews; you need the exact link.
// - Commenters can edit or delete only their own comments. Whoever started a thread can delete it.
// - Only the storyboard's owner (the app that holds the secret owner key) can update the
//   storyboard, resolve comments, post "Team" replies, or delete anything.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function reviewPath(reviewId) {
      return /databases/$(database)/documents/reviews/$(reviewId);
    }

    function isOwner(reviewId) {
      return signedIn()
        && exists(/databases/$(database)/documents/reviews/$(reviewId)/owners/$(request.auth.uid));
    }

    // ---------- Team: Google accounts approved by an admin ----------

    function googleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function memberPath(email) {
      return /databases/$(database)/documents/members/$(email);
    }

    function teamPath() {
      return /databases/$(database)/documents/team/settings;
    }

    function isMember() {
      return googleUser()
        && exists(memberPath(myEmail()))
        && get(memberPath(myEmail())).data.role in ['admin', 'member'];
    }

    function isAdmin() {
      return isMember() && get(memberPath(myEmail())).data.role == 'admin';
    }

    function validMember(email) {
      return request.resource.data.keys().hasOnly(['email', 'role', 'name', 'addedBy', 'addedAt'])
        && request.resource.data.email == email;
    }

    // Signed in with a Google account at the team's domain (when the team has one set).
    function atTeamDomain() {
      let domain = get(teamPath()).data.get('domain', '');
      let parts = myEmail().split('@');
      return domain is string && domain != '' && parts[parts.size() - 1] == domain;
    }

    function validTeam() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'createdBy', 'createdAt', 'domain'])
        && d.name is string
        && d.name.size() <= 80
        && (!('domain' in d) || (d.domain is string
          && d.domain.size() <= 100
          && !(d.domain in ['gmail.com', 'googlemail.com'])));
    }

    match /team/settings {
      allow get: if googleUser();
      allow create: if googleUser()
        && validTeam()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(memberPath(myEmail())).data.role == 'admin';
      allow update: if isAdmin()
        && validTeam()
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    match /members/{email} {
      allow get: if googleUser() && (email == myEmail() || isMember());
      allow list: if isMember();
      // Admins approve people. The very first admin is created together with the team itself.
      // People at the team's domain can add themselves (unless they were removed: that document
      // still exists, so this would be an update, which only admins can make).
      allow create: if validMember(email) && (
        (isAdmin() && request.resource.data.role in ['admin', 'member'])
        || (googleUser()
          && email == myEmail()
          && request.resource.data.role == 'admin'
          && !exists(teamPath())
          && getAfter(teamPath()).data.createdBy == request.auth.uid)
        || (googleUser()
          && email == myEmail()
          && request.resource.data.role == 'member'
          && exists(teamPath())
          && atTeamDomain())
      );
      // Admins can't change or remove themselves, so a team can't lose its last admin by accident.
      allow update: if isAdmin()
        && email != myEmail()
        && validMember(email)
        && request.resource.data.role in ['admin', 'member', 'removed'];
      allow delete: if isAdmin() && email != myEmail();
    }

    function holdsLock(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isMember() && board.lock != null && board.lock.uid == request.auth.uid;
    }

    match /boards/{boardId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.lock.uid == request.auth.uid;
      allow update: if isMember() && (
        // Taking, keeping or releasing the editing lock (the app asks before taking over).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lock'])
          && (request.resource.data.lock == null || request.resource.data.lock.uid == request.auth.uid))
        // Saving: only whoever holds the lock, and they keep it.
        || (resource.data.lock != null
          && resource.data.lock.uid == request.auth.uid
          && request.resource.data.lock != null
          && request.resource.data.lock.uid == request.auth.uid)
      );
      allow delete: if isMember() && resource.data.lock != null && resource.data.lock.uid == request.auth.uid;

      match /data/{docId} {
        allow read: if isMember();
        allow write: if holdsLock(boardId);
      }

      match /images/{imageId} {
        allow read: if isMember();
        allow write: if holdsLock(boardId);
      }
    }

    // ---------- Client review links ----------

    match /reviews/{reviewId} {
      allow get: if true;
      allow list: if false;
      allow create: if isMember()
        && request.resource.data.ownerKeyHash is string
        && request.resource.data.ownerKeyHash.size() == 64;
      allow update: if isOwner(reviewId)
        && request.resource.data.ownerKeyHash == resource.data.ownerKeyHash;
      allow delete: if isOwner(reviewId);

      // Proof of ownership: a browser becomes an owner by presenting the secret key whose
      // SHA-256 hash is stored on the review. These documents are never readable by others.
      match /owners/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key', 'createdAt'])
          && request.resource.data.key is string
          && hashing.sha256(request.resource.data.key).toHexString().lower()
             == get(reviewPath(reviewId)).data.ownerKeyHash;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow list, update: if false;
      }

      match /images/{imageId} {
        allow read: if true;
        allow write: if isOwner(reviewId);
      }

      match /comments/{commentId} {
        function validContent(d) {
          return d.authorName is string
            && d.authorName.size() > 0
            && d.authorName.size() <= 80
            && d.body is string
            && d.body.size() <= 5000
            && d.kind in ['comment', 'suggestion', 'reply'];
        }

        function startedThread() {
          return resource.data.parentId is string
            && get(/databases/$(database)/documents/reviews/$(reviewId)/comments/$(resource.data.parentId)).data.authorUid == request.auth.uid;
        }

        allow read: if true;

        allow create: if signedIn()
          && exists(reviewPath(reviewId))
          && request.resource.data.authorUid == request.auth.uid
          && validContent(request.resource.data)
          && request.resource.data.status == 'open'
          && request.resource.data.isTeam is bool
          && (request.resource.data.isTeam == false || isOwner(reviewId));

        allow update: if signedIn() && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'suggestion', 'updatedAt', 'edited', 'authorName'])
            && validContent(request.resource.data))
          || (isOwner(reviewId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resolvedAt', 'resolvedBy']))
        );

        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || isOwner(reviewId)
          || startedThread()
        );
      }
    }
  }
}
